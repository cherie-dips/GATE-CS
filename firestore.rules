rules_version = '2';

// Cloud sync for the GATE CSE question bank: each signed-in user can read and write only their own progress
// document, progress/{their uid}. Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /progress/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
